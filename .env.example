# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── URLs ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://www.tamma.me

# ── Wave payments (https://developers.wave.com) ─────────────────────────────
WAVE_API_KEY=your_wave_api_key
WAVE_WEBHOOK_SECRET=your_wave_webhook_secret
WAVE_SIGNING_SECRET=your_wave_signing_secret

# ── Resend email (https://resend.com) ───────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# ── Web push (generate with: npx web-push generate-vapid-keys) ──────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# ── SMS (MTarget) ───────────────────────────────────────────────────────────
MTARGET_USERNAME=your_mtarget_username
MTARGET_PASSWORD=your_mtarget_password
MTARGET_SERVICEID=36453
# MTARGET_API_URL=https://api-public.mtarget.fr
# Shared secret appended as ?secret= to the DLR/MO callback URLs configured
# at MTarget. Required in production (webhooks fail closed without it).
SMS_WEBHOOK_SECRET=your_sms_webhook_secret

# ── Cron / internal ─────────────────────────────────────────────────────────
CRON_SECRET=your_cron_secret
INTERNAL_SECRET=your_internal_secret

# ── AI (Awa assistant, landing-page generator) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Sentry (https://sentry.io) ──────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# ── Misc ────────────────────────────────────────────────────────────────────
# ADMIN_ALERT_EMAIL=alerts@example.com
